#!/usr/bin/env bash
# Turn an attempted direct push to a personal standalone repo's default branch
# into a feature branch, pull request, verified squash merge, and clean local
# handoff back to the updated default branch. All other pushes pass through.
set -u

remote_name=${1:-origin}
remote_url=${2:-}
mapfile -t push_lines

run_legacy_hook() {
  local git_dir legacy
  git_dir=$(git rev-parse --git-dir 2>/dev/null) || return 0
  legacy=$git_dir/hooks/pre-push
  [[ -x $legacy ]] || return 0
  printf '%s\n' "${push_lines[@]}" | "$legacy" "$remote_name" "$remote_url"
}

# Preserve repository-owned hooks. A local core.hooksPath overrides this tool,
# while a conventional .git/hooks/pre-push is explicitly chained here.
run_legacy_hook
legacy_status=$?
((legacy_status == 0)) || exit "$legacy_status"

owner=$(git config --get prflow.owner 2>/dev/null || true)
[[ -n $owner ]] || exit 0

case "$remote_url" in
  git@github.com:"$owner"/*|ssh://git@github.com/"$owner"/*|https://github.com/"$owner"/*|http://github.com/"$owner"/*) ;;
  *) exit 0 ;;
esac

repo=${remote_url%.git}
repo=${repo##*/}
mapfile -t excluded_repos < <(git config --get-all prflow.excludeRepo 2>/dev/null || true)
for excluded in "${excluded_repos[@]}"; do
  [[ $repo == "$excluded" ]] && exit 0
done

enabled=$(git config --local --get prflow.enabled 2>/dev/null || true)
[[ $enabled == false ]] && exit 0

gh_bin=$(command -v gh 2>/dev/null || true)
if [[ -z $gh_bin ]]; then
  echo "git-pr-flow: gh is unavailable; refusing to guess whether this personal repository is a fork." >&2
  echo "git-pr-flow: install/authenticate GitHub CLI or set 'git config prflow.enabled false'." >&2
  exit 1
fi

slug=$owner/$repo
repo_info=$($gh_bin repo view "$slug" --json isFork,defaultBranchRef --jq '[.isFork, .defaultBranchRef.name] | @tsv' 2>/dev/null || true)
if [[ -z $repo_info ]]; then
  echo "git-pr-flow: could not inspect $slug; direct default-branch push was not attempted." >&2
  exit 1
fi
is_fork=${repo_info%%$'\t'*}
default_branch=${repo_info#*$'\t'}

# Fork defaults are commonly synchronization targets. Leave their upstream PR
# workflow alone unless the repository explicitly opts in.
[[ $is_fork == true && $enabled != true ]] && exit 0
[[ -n $default_branch ]] || exit 0

zero=0000000000000000000000000000000000000000
intercept=false
remote_oid=
for line in "${push_lines[@]}"; do
  read -r local_ref local_oid remote_ref candidate_remote_oid <<<"$line"
  if [[ $local_ref == "refs/heads/$default_branch" && $remote_ref == "refs/heads/$default_branch" && $local_oid != "$zero" ]]; then
    intercept=true
    remote_oid=$candidate_remote_oid
    break
  fi
done
[[ $intercept == true ]] || exit 0

# The first push establishes a base branch; there is nothing to make a PR
# against yet.
[[ $remote_oid == "$zero" ]] && exit 0

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[[ $current == "$default_branch" ]] || exit 0

remote_tracking=refs/remotes/$remote_name/$default_branch
git fetch --quiet "$remote_name" "$default_branch" || exit 1

if ! git merge-base --is-ancestor "$remote_tracking" HEAD; then
  echo "git-pr-flow: $default_branch has diverged from $remote_name/$default_branch; refusing an automatic rewrite." >&2
  echo "git-pr-flow: rebase or merge the remote branch, then push again." >&2
  exit 1
fi

ahead=$(git rev-list --count "$remote_tracking"..HEAD)
((ahead > 0)) || exit 0

subject=$(git log --reverse --format=%s "$remote_tracking"..HEAD | head -n 1)
slug_text=$(printf '%s' "$subject" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/^(.{1,42}).*$/\1/; s/-+$//')
[[ -n $slug_text ]] || slug_text=changes
branch=work/$(date +%Y%m%d)-$slug_text
if git show-ref --verify --quiet "refs/heads/$branch" || git ls-remote --exit-code --heads "$remote_name" "$branch" >/dev/null 2>&1; then
  branch=$branch-$(git rev-parse --short HEAD)
fi

echo "git-pr-flow: direct push to $default_branch detected; publishing $ahead commit(s) as $branch instead." >&2
git branch "$branch" HEAD || exit 1
git switch "$branch" >/dev/null || exit 1

if ! git push --no-verify --set-upstream "$remote_name" "HEAD:refs/heads/$branch"; then
  echo "git-pr-flow: branch is preserved locally as $branch; its push failed." >&2
  exit 1
fi

pr_output=$($gh_bin pr create --repo "$slug" --base "$default_branch" --head "$branch" --fill-first 2>&1) || {
  echo "git-pr-flow: branch was pushed, but PR creation failed:" >&2
  echo "$pr_output" >&2
  exit 1
}
pr_url=$(printf '%s\n' "$pr_output" | sed -nE 's#.*(https://github\.com/[^[:space:]]+/pull/[0-9]+).*#\1#p' | tail -n 1)
[[ -n $pr_url ]] || pr_url=$pr_output

# We are now on the preserved work branch, so returning the local default
# pointer to the remote base cannot discard work.
git branch --force "$default_branch" "$remote_name/$default_branch" >/dev/null

echo >&2
echo "git-pr-flow: created PR: $pr_url" >&2
echo "git-pr-flow: waiting for CI before squash-merging." >&2

merge_timeout=$(git config --get prflow.mergeTimeout 2>/dev/null || echo 900)
poll_interval=$(git config --get prflow.pollInterval 2>/dev/null || echo 5)
check_grace=$(git config --get prflow.checkGrace 2>/dev/null || echo 15)
[[ $merge_timeout =~ ^[0-9]+$ ]] || merge_timeout=900
[[ $poll_interval =~ ^[1-9][0-9]*$ ]] || poll_interval=5
[[ $check_grace =~ ^[0-9]+$ ]] || check_grace=15

started=$SECONDS
while ((SECONDS - started < merge_timeout)); do
  summary=$($gh_bin pr view "$pr_url" --repo "$slug" --json state,mergeable,statusCheckRollup --jq '
    [.state,
     .mergeable,
     (.statusCheckRollup | length),
     ([.statusCheckRollup[] |
       select((.status != null and .status != "COMPLETED") or
              (.state != null and .state != "SUCCESS" and .state != "ERROR" and .state != "FAILURE"))] | length),
     ([.statusCheckRollup[] |
       select((.conclusion == "FAILURE") or
              (.conclusion == "CANCELLED") or
              (.conclusion == "TIMED_OUT") or
              (.conclusion == "ACTION_REQUIRED") or
              (.conclusion == "STARTUP_FAILURE") or
              (.state == "ERROR") or
              (.state == "FAILURE"))] | length)] | @tsv' 2>/dev/null || true)

  if [[ -z $summary ]]; then
    echo "git-pr-flow: could not read PR checks; retrying." >&2
    sleep "$poll_interval"
    continue
  fi

  IFS=$'\t' read -r pr_state mergeable check_count pending_count failed_count <<<"$summary"
  if [[ $pr_state != OPEN ]]; then
    echo "git-pr-flow: PR is no longer open ($pr_state); leaving $branch checked out." >&2
    exit 1
  fi
  if ((failed_count > 0)); then
    echo "git-pr-flow: CI failed; leaving the PR and $branch open for repair." >&2
    echo "git-pr-flow: $pr_url" >&2
    exit 1
  fi

  elapsed=$((SECONDS - started))
  checks_ready=false
  if ((check_count > 0 && pending_count == 0 && elapsed >= check_grace)); then
    checks_ready=true
  elif ((check_count == 0 && elapsed >= check_grace)); then
    echo "git-pr-flow: no CI checks appeared during the ${check_grace}s grace period." >&2
    checks_ready=true
  fi

  if [[ $checks_ready == true && $mergeable == MERGEABLE ]]; then
    head_oid=$(git rev-parse HEAD)
    if ! merge_output=$($gh_bin pr merge "$pr_url" --repo "$slug" --squash --match-head-commit "$head_oid" 2>&1); then
      echo "git-pr-flow: checks passed, but GitHub refused the squash merge:" >&2
      echo "$merge_output" >&2
      echo "git-pr-flow: leaving the PR and $branch open." >&2
      exit 1
    fi

    git fetch --quiet "$remote_name" "$default_branch" || {
      echo "git-pr-flow: PR merged, but the updated $default_branch could not be fetched." >&2
      echo "git-pr-flow: run: git switch $default_branch && git pull --ff-only" >&2
      exit 1
    }
    git branch --force "$default_branch" "$remote_name/$default_branch" >/dev/null
    git switch "$default_branch" >/dev/null || exit 1
    git push --no-verify "$remote_name" --delete "$branch" >/dev/null 2>&1 || true
    git branch -D "$branch" >/dev/null 2>&1 || true

    echo >&2
    echo "git-pr-flow: COMPLETE — CI passed and the PR was squash-merged." >&2
    echo "git-pr-flow: $pr_url" >&2
    echo "git-pr-flow: local $default_branch is current; the work branch was removed." >&2
    echo "git-pr-flow: the original direct push was cancelled because the PR replaced it." >&2
    exit 1
  fi

  if ((check_count > 0)); then
    echo "git-pr-flow: CI $((check_count - pending_count))/$check_count complete; waiting." >&2
  else
    echo "git-pr-flow: waiting for CI to register." >&2
  fi
  sleep "$poll_interval"
done

echo "git-pr-flow: timed out after ${merge_timeout}s; leaving the PR and $branch open." >&2
echo "git-pr-flow: $pr_url" >&2
exit 1
