#!/usr/bin/env bash
# Turn an attempted direct push to a personal standalone repo's default branch
# into a feature branch and draft pull request. All other pushes pass through.
set -u

remote_name=${1:-origin}
remote_url=${2:-}
mapfile -t push_lines

run_legacy_hook() {
  local git_dir legacy
  git_dir=$(git rev-parse --git-dir 2>/dev/null) || return 0
  legacy=$git_dir/hooks/pre-push
  [[ -x $legacy ]] || return 0
  printf '%s\n' "${push_lines[@]}" | "$legacy" "$remote_name" "$remote_url"
}

# Preserve repository-owned hooks. A local core.hooksPath overrides this tool,
# while a conventional .git/hooks/pre-push is explicitly chained here.
run_legacy_hook
legacy_status=$?
((legacy_status == 0)) || exit "$legacy_status"

owner=$(git config --get prflow.owner 2>/dev/null || true)
[[ -n $owner ]] || exit 0

case "$remote_url" in
  git@github.com:"$owner"/*|ssh://git@github.com/"$owner"/*|https://github.com/"$owner"/*|http://github.com/"$owner"/*) ;;
  *) exit 0 ;;
esac

repo=${remote_url%.git}
repo=${repo##*/}
mapfile -t excluded_repos < <(git config --get-all prflow.excludeRepo 2>/dev/null || true)
for excluded in "${excluded_repos[@]}"; do
  [[ $repo == "$excluded" ]] && exit 0
done

enabled=$(git config --local --get prflow.enabled 2>/dev/null || true)
[[ $enabled == false ]] && exit 0

gh_bin=$(command -v gh 2>/dev/null || true)
if [[ -z $gh_bin ]]; then
  echo "git-pr-flow: gh is unavailable; refusing to guess whether this personal repository is a fork." >&2
  echo "git-pr-flow: install/authenticate GitHub CLI or set 'git config prflow.enabled false'." >&2
  exit 1
fi

slug=$owner/$repo
repo_info=$($gh_bin repo view "$slug" --json isFork,defaultBranchRef --jq '[.isFork, .defaultBranchRef.name] | @tsv' 2>/dev/null || true)
if [[ -z $repo_info ]]; then
  echo "git-pr-flow: could not inspect $slug; direct default-branch push was not attempted." >&2
  exit 1
fi
is_fork=${repo_info%%$'\t'*}
default_branch=${repo_info#*$'\t'}

# Fork defaults are commonly synchronization targets. Leave their upstream PR
# workflow alone unless the repository explicitly opts in.
[[ $is_fork == true && $enabled != true ]] && exit 0
[[ -n $default_branch ]] || exit 0

zero=0000000000000000000000000000000000000000
intercept=false
remote_oid=
for line in "${push_lines[@]}"; do
  read -r local_ref local_oid remote_ref candidate_remote_oid <<<"$line"
  if [[ $local_ref == "refs/heads/$default_branch" && $remote_ref == "refs/heads/$default_branch" && $local_oid != "$zero" ]]; then
    intercept=true
    remote_oid=$candidate_remote_oid
    break
  fi
done
[[ $intercept == true ]] || exit 0

# The first push establishes a base branch; there is nothing to make a PR
# against yet.
[[ $remote_oid == "$zero" ]] && exit 0

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[[ $current == "$default_branch" ]] || exit 0

remote_tracking=refs/remotes/$remote_name/$default_branch
git fetch --quiet "$remote_name" "$default_branch" || exit 1

if ! git merge-base --is-ancestor "$remote_tracking" HEAD; then
  echo "git-pr-flow: $default_branch has diverged from $remote_name/$default_branch; refusing an automatic rewrite." >&2
  echo "git-pr-flow: rebase or merge the remote branch, then push again." >&2
  exit 1
fi

ahead=$(git rev-list --count "$remote_tracking"..HEAD)
((ahead > 0)) || exit 0

subject=$(git log --reverse --format=%s "$remote_tracking"..HEAD | head -n 1)
slug_text=$(printf '%s' "$subject" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/^(.{1,42}).*$/\1/; s/-+$//')
[[ -n $slug_text ]] || slug_text=changes
branch=work/$(date +%Y%m%d)-$slug_text
if git show-ref --verify --quiet "refs/heads/$branch" || git ls-remote --exit-code --heads "$remote_name" "$branch" >/dev/null 2>&1; then
  branch=$branch-$(git rev-parse --short HEAD)
fi

echo "git-pr-flow: direct push to $default_branch detected; publishing $ahead commit(s) as $branch instead." >&2
git branch "$branch" HEAD || exit 1
git switch "$branch" >/dev/null || exit 1

if ! git push --no-verify --set-upstream "$remote_name" "HEAD:refs/heads/$branch"; then
  echo "git-pr-flow: branch is preserved locally as $branch; its push failed." >&2
  exit 1
fi

pr_url=$($gh_bin pr create --repo "$slug" --base "$default_branch" --head "$branch" --draft --fill-first 2>&1) || {
  echo "git-pr-flow: branch was pushed, but draft PR creation failed:" >&2
  echo "$pr_url" >&2
  exit 1
}

# We are now on the preserved work branch, so returning the local default
# pointer to the remote base cannot discard work.
git branch --force "$default_branch" "$remote_name/$default_branch" >/dev/null

echo >&2
echo "git-pr-flow: created draft PR: $pr_url" >&2
echo "git-pr-flow: you are now on $branch; future pushes update that PR." >&2
echo "git-pr-flow: the original direct push was intentionally cancelled." >&2
exit 1
